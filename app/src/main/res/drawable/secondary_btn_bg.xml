<?xml version="1.0" encoding="utf-8"?>
<!-- 보조 알약 버튼(목적지, 전화, 읽어주기). -->
<!-- 반지름은 높이의 절반으로 자동 제한되므로 넉넉히 잡아 높이가 바뀌어도 항상 알약 모양이 되게 한다. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/pressed" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/btn_secondary" />
            <stroke android:width="2dp" android:color="@color/btn_secondary_outline" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
