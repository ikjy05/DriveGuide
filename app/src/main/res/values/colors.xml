<?xml version="1.0" encoding="utf-8"?>
<!-- 라이트 테마 색. 다크는 values-night/colors.xml. 시스템(Pleos) 테마를 따라 자동 전환된다.
     사진 위에 얹는 글씨·그라데이션은 테마와 무관하게 레이아웃에 고정 색을 쓴다. -->
<resources>
    <color name="bg">#F3F5F8</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#E3E8EE</color>
    <color name="pressed">#E3E8EE</color>
    <color name="outline">#C9D1DB</color>
    <color name="text_primary">#111418</color>
    <color name="text_body">#2B3440</color>
    <color name="text_secondary">#5B6573</color>
    <color name="text_tertiary">#8A94A1</color>
    <color name="on_surface">#1F2A37</color>
    <color name="accent">#5BA8F5</color>
    <color name="accent_pressed">#3B8DE0</color>
    <color name="accent_text">#2B7BD8</color>
    <color name="on_accent">#0B1220</color>

    <!-- Pleos 기본 앱 규칙: 주요 버튼은 검정, 보조 버튼은 라이트에서 흰색·다크에서 검정 -->
    <color name="btn_primary">#111418</color>
    <color name="btn_primary_pressed">#3A4150</color>
    <color name="on_btn_primary">#FFFFFF</color>
    <color name="btn_secondary">#FFFFFF</color>
    <color name="btn_secondary_outline">#D5DAE0</color>
    <color name="on_btn_secondary">#111418</color>

    <!-- 빈 상태 그림 -->
    <color name="empty_road">#D5DCE4</color>
    <color name="empty_lane">#FFFFFF</color>

    <!-- 종류 배지 색 점. 사진 위에 얹으므로 테마와 무관하게 같은 색이다(values-night에 두지 않음). -->
    <color name="type_attraction">#5BA8F5</color>
    <color name="type_course">#FFB020</color>
</resources>
