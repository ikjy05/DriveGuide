<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 시스템 라이트/다크 설정을 따른다(색은 values / values-night의 colors.xml). -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- 상세 화면 알약 버튼 -->
    <style name="PillButton" parent="@android:style/Widget.DeviceDefault.Button.Borderless">
        <item name="android:layout_height">64dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PillButton.Primary">
        <item name="android:background">@drawable/waypoint_btn_bg</item>
        <item name="android:textColor">@color/on_btn_primary</item>
    </style>

    <style name="PillButton.Secondary">
        <item name="android:background">@drawable/secondary_btn_bg</item>
        <item name="android:textColor">@color/on_btn_secondary</item>
    </style>

    <!-- 상세 화면은 사진 위에 얹으므로 테마와 무관한 색을 쓴다. -->
    <style name="PillButton.OnPhoto">
        <item name="android:background">@drawable/photo_primary_btn_bg</item>
        <item name="android:textColor">#111418</item>
        <item name="android:drawableTint">#111418</item>
    </style>

    <style name="PillButton.OnPhotoGlass">
        <item name="android:background">@drawable/photo_secondary_btn_bg</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:drawableTint">#FFFFFF</item>
    </style>

    <style name="DetailSectionTitle">
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
