<?xml version="1.0" encoding="utf-8"?>
<!-- 상세 본문(반투명 패널 안): 소개, 코스 구성, 출처. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="#FFFFFF" />

    <TextView
        android:id="@+id/errorText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#CCFFFFFF"
        android:textSize="27sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/overviewSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/DetailSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:text="소개" />

            <Button
                android:id="@+id/btnRead"
                style="@style/PillButton.OnPhotoGlass"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:drawableStart="@drawable/ic_volume"
                android:text="읽어주기"
                android:textSize="24sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/drivingNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/photo_row_bg"
            android:padding="16dp"
            android:text="주행 중에는 소개글을 숨깁니다. 읽어주기로 들어보세요."
            android:textColor="#E6FFFFFF"
            android:textSize="27sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/overviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.35"
            android:textColor="#E6FFFFFF"
            android:textSize="27sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/courseSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/courseTitle"
            style="@style/DetailSectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/stopsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="사진·정보 제공: 한국관광공사"
        android:textColor="#99FFFFFF"
        android:textSize="19sp" />
</LinearLayout>
