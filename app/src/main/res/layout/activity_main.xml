<?xml version="1.0" encoding="utf-8"?>
<!-- 좁은 창(분할 화면) 레이아웃. 넓은 창은 layout-w1200dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 앱 아이콘 + 지역 이름(Pleos 기본 앱처럼 왼쪽 위에 아이콘을 둔다) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="18dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/regionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치 확인 중…"
                android:textColor="@color/text_primary"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/tab_group_bg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabAttractions"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="관광지"
            android:textSize="26sp" />

        <Button
            android:id="@+id/tabCourses"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="코스"
            android:textSize="26sp" />

        <Button
            android:id="@+id/tabUpcoming"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="가는 길"
            android:textSize="26sp" />

        <Button
            android:id="@+id/tabSaved"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_weight="1"
            android:text="즐겨찾기"
            android:textSize="26sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
