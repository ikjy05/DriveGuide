<?xml version="1.0" encoding="utf-8"?>
<!-- 좁은 창(분할 화면) 레이아웃. 넓은 창은 layout-w1200dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp">

    <!-- 앱 아이콘 + 지역 이름(Pleos 기본 앱처럼 왼쪽 위에 아이콘을 둔다) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginEnd="18dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/regionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치 확인 중…"
                android:textColor="@color/text_primary"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_secondary"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- 목록은 탭바 뒤까지 이어지고, 탭바는 그 위에 떠 있다. 마지막 카드가 가려지지 않게 아래 여백을 둔다. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/listScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="148dp">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 하단 탭바: 아이콘 + 이름, 아래에 띄운 알약 모양. -->
        <LinearLayout
            android:id="@+id/tabBar"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bottom_tab_bar_bg"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <Button
                android:id="@+id/tabAttractions"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bottom_tab_bg"
                android:drawableTop="@drawable/tab_ic_place"
                android:drawablePadding="4dp"
                android:drawableTint="@color/tab_text"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:stateListAnimator="@null"
                android:text="관광지"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="24sp" />

            <Button
                android:id="@+id/tabCourses"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bottom_tab_bg"
                android:drawableTop="@drawable/tab_ic_course"
                android:drawablePadding="4dp"
                android:drawableTint="@color/tab_text"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:stateListAnimator="@null"
                android:text="코스"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="24sp" />

            <Button
                android:id="@+id/tabUpcoming"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bottom_tab_bg"
                android:drawableTop="@drawable/tab_ic_upcoming"
                android:drawablePadding="4dp"
                android:drawableTint="@color/tab_text"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:stateListAnimator="@null"
                android:text="가는 길"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="24sp" />

            <Button
                android:id="@+id/tabSaved"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:layout_marginVertical="10dp"
                android:background="@drawable/bottom_tab_bg"
                android:drawableTop="@drawable/tab_ic_saved"
                android:drawablePadding="4dp"
                android:drawableTint="@color/tab_text"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:stateListAnimator="@null"
                android:text="저장"
                android:textAllCaps="false"
                android:textColor="@color/tab_text"
                android:textSize="24sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
