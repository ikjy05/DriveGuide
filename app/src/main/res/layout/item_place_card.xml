<?xml version="1.0" encoding="utf-8"?>
<!-- 추천 장소 카드: 16:9 사진 위에 제목·거리·경유지 버튼을 얹는다. 열 수는 values / values-w1200dp. -->
<com.example.driveguide.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/card_bg">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_scrim" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/badge_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#0B1220"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/card_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#E1E6EC"
                android:textSize="@dimen/card_meta_size" />
        </LinearLayout>

        <Button
            android:id="@+id/addWaypoint"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/waypoint_btn_bg"
            android:drawableStart="@drawable/ic_add_location"
            android:drawablePadding="8dp"
            android:elevation="4dp"
            android:paddingStart="18dp"
            android:paddingEnd="22dp"
            android:stateListAnimator="@null"
            android:text="경유지"
            android:textAllCaps="false"
            android:textColor="@color/on_btn_primary"
            android:textSize="21sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.example.driveguide.ui.AspectRatioFrameLayout>
