<?xml version="1.0" encoding="utf-8"?>
<!-- 추천 장소 카드: 16:9 사진 위에 제목·거리·경유지 버튼을 얹는다. 열 수는 values / values-w1200dp. -->
<com.example.driveguide.ui.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/card_bg">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_scrim" />

    <TextView
        android:id="@+id/badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:background="@drawable/badge_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#0B1220"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/card_title_size"
                android:textStyle="bold" />

            <!-- 차 기준 방향 화살표 + 거리·방향·주소 한 줄. 진행 방향을 모르면 화살표를 숨긴다. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/direction"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_direction"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6"
                    android:textColor="#E1E6EC"
                    android:textSize="@dimen/card_meta_size" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/addWaypoint"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="76dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/waypoint_btn_bg"
            android:drawableStart="@drawable/ic_add_location"
            android:drawablePadding="8dp"
            android:elevation="4dp"
            android:paddingStart="22dp"
            android:paddingEnd="28dp"
            android:stateListAnimator="@null"
            android:text="경유지"
            android:textAllCaps="false"
            android:textColor="@color/on_btn_primary"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.example.driveguide.ui.AspectRatioFrameLayout>
