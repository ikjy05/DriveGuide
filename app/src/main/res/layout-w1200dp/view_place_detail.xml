<?xml version="1.0" encoding="utf-8"?>
<!-- 넓은 창(전체 화면) 상세: 사진이 창 전체를 채우고(좌우로 밀면 이전·다음 장소), 왼쪽 아래 이름·버튼, 오른쪽 아래 반투명 패널에 본문(내용 높이만큼, 넘치면 스크롤). -->
<com.example.driveguide.ui.SwipeFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:gravity="bottom"
            android:orientation="vertical">

            <include layout="@layout/detail_header" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/bodyPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="32dp"
            android:layout_weight="0.85"
            android:background="@drawable/photo_panel_bg"
            android:scrollbars="none">

            <include
                layout="@layout/detail_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="28dp" />
        </ScrollView>
    </LinearLayout>

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="32dp"
        android:background="@drawable/round_dark_bg"
        android:contentDescription="뒤로"
        android:src="@drawable/ic_back" />

    <include
        layout="@layout/detail_pager"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp" />
</com.example.driveguide.ui.SwipeFrameLayout>
