<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingHorizontal="32dp"
    android:paddingTop="32dp">

    <!-- 앱 아이콘 + 지역 이름(Pleos 기본 앱처럼 왼쪽 위에 아이콘을 둔다) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="22dp"
            android:importantForAccessibility="no"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/regionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치 확인 중…"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>


    <!-- 목록은 탭바 뒤까지 이어지고, 탭바는 그 위에 떠 있다. 마지막 카드가 가려지지 않게 아래 여백을 둔다. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/listScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="164dp">

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 하단 탭바: Material 3 플로팅 툴바. 목록 위에 떠 있고, 선택된 탭만 아이콘 + 둥근 배경. -->
        <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
            android:id="@+id/tabBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:theme="@style/ThemeOverlay.DriveGuide.TabToolbar">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="128dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabAttractions"
                    style="@style/TabToolbarButton"
                    android:text="관광지"
                    android:textSize="30sp"
                    app:icon="@drawable/tab_ic_place" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabCourses"
                    style="@style/TabToolbarButton"
                    android:text="코스"
                    android:textSize="30sp"
                    app:icon="@drawable/tab_ic_course" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabUpcoming"
                    style="@style/TabToolbarButton"
                    android:text="가는 길"
                    android:textSize="30sp"
                    app:icon="@drawable/tab_ic_upcoming" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tabSaved"
                    style="@style/TabToolbarButton"
                    android:text="저장"
                    android:textSize="30sp"
                    app:icon="@drawable/tab_ic_saved" />
            </LinearLayout>
        </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
    </FrameLayout>
</LinearLayout>
