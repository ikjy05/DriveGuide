<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- 앱 아이콘 + 지역 이름(Pleos 기본 앱처럼 왼쪽 위에 아이콘을 둔다) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 런처 아이콘의 두 레이어를 모양 마스크 없이 네모로 보여준다.
             적응형 아이콘은 108dp 중 가운데 72dp가 보이는 영역이라 1.5배 키워 가장자리를 잘라낸다. -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="22dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:src="@drawable/ic_launcher_background" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleX="1.5"
                android:scaleY="1.5"
                android:src="@drawable/ic_launcher_foreground" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/regionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="위치 확인 중…"
                android:textColor="@color/text_primary"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="28sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/tab_group_bg"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabAttractions"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:text="관광지"
            android:textSize="28sp" />

        <Button
            android:id="@+id/tabCourses"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:text="드라이브·여행코스"
            android:textSize="28sp" />

        <Button
            android:id="@+id/tabUpcoming"
            style="?android:attr/borderlessButtonStyle"
            android:background="@drawable/tab_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/tab_text"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_weight="1"
            android:text="가는 길 추천"
            android:textSize="28sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
